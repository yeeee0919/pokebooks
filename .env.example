# Copy to Vercel project env (Production + Preview). Never commit real values.

# Supabase Postgres (Settings → Database → URI). Prefer the pooler URI (port 6543).
DATABASE_URL=

# Random long string
SESSION_SECRET=

# Web login password (single owner)
OWNER_PASSWORD=

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: setWebhook secret_token, must match header
TELEGRAM_WEBHOOK_SECRET=

# Vision guesses (optional — without this, bot still asks blank questions)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# After deploy:
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=https://YOUR_DOMAIN/api/telegram&secret_token=$TELEGRAM_WEBHOOK_SECRET"

# Mac cardmarket-monitor ingest (Bearer token). Not the web login password.
# Set the same value on Vercel (Production + Preview) and on the Mac that pushes latest.json.
CARDMARKET_INGEST_TOKEN=

# Upload a daily snapshot (session cookie is not required):
# curl -X POST "https://pokebooks-mu.vercel.app/api/cardmarket" \
#   -H "Authorization: Bearer $CARDMARKET_INGEST_TOKEN" \
#   -H "Content-Type: application/json" \
#   --data-binary @latest.json
# Or: CARDMARKET_INGEST_TOKEN=... node scripts/push-cardmarket-snapshot.mjs latest.json
