# Copy to Vercel project env (Production + Preview). Never commit real values.

# Neon (Frankfurt or Amsterdam)
DATABASE_URL=

# Random long string
SESSION_SECRET=

# Web login password (single owner)
OWNER_PASSWORD=

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: setWebhook secret_token, must match header
TELEGRAM_WEBHOOK_SECRET=

# Vision guesses (optional — without this, bot still asks blank questions)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# After deploy:
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=https://YOUR_DOMAIN/api/telegram&secret_token=$TELEGRAM_WEBHOOK_SECRET"
